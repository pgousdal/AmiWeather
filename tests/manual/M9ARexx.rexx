/* Manual M9 query qualification; this file is not release-packaged. */
OPTIONS RESULTS
OPTIONS FAILAT 21
ADDRESS AMIWEATHER
RESULT = ''
'VERSION'
SAY 'VERSION RC=' RC ' RESULT=' RESULT
