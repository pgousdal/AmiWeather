/* Query the running AmiWeather GUI. */
OPTIONS RESULTS
OPTIONS FAILAT 21
ADDRESS AMIWEATHER
RESULT = ''
'GET LOCATION'
SAY 'GET LOCATION RC=' RC ' RESULT=' RESULT
RESULT = ''
'GET TEMPERATURE'
SAY 'GET TEMPERATURE RC=' RC ' RESULT=' RESULT
RESULT = ''
'GET CONDITION'
SAY 'GET CONDITION RC=' RC ' RESULT=' RESULT
RESULT = ''
'GET HUMIDITY'
SAY 'GET HUMIDITY RC=' RC ' RESULT=' RESULT
RESULT = ''
'GET WIND'
SAY 'GET WIND RC=' RC ' RESULT=' RESULT
